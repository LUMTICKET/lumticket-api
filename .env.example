# ---------------------------------------------------------------------------
# Database (PostgreSQL) — Neon example shown; Supabase/local Postgres also work.
#
# Neon: create a project at https://console.neon.tech, copy the "Pooled
# connection" string for DATABASE_URL (used by the app at runtime) and the
# "Direct connection" string for DIRECT_URL (used by `prisma migrate`).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<neon-host>.<region>.aws.neon.tech/<db>?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payment gateway (stub — FR-11). Replace with your licensed processor's keys.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Cron endpoint protection (FR-22 seat-hold expiry sweep, see docs/API.md)
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-a-random-secret"
